# 大数据标签系统环境变量配置模板
# 复制此文件为 .env 并填入实际值

# MySQL 数据库配置
MYSQL_HOST=your-mysql-host.example.com
MYSQL_PORT=3358
MYSQL_DATABASE=biz_user
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# Elasticsearch 配置
ES_HOSTS=http://your-es-host:9200
ES_USER=your_es_user
ES_PASSWORD=your_es_password
ES_INDEX=user_tag_relation

# MaxCompute 配置
MAXCOMPUTE_PROJECT=your_project_name
MAXCOMPUTE_ACCESS_ID=your_aliyun_access_key_id
MAXCOMPUTE_ACCESS_KEY=your_aliyun_access_key_secret
MAXCOMPUTE_ENDPOINT=https://service.ap-southeast-1.maxcompute.aliyun.com/api

# 说明:
# 1. 不同环境（dev/test/pre/prod）的敏感配置应通过环境变量设置
# 2. config.yaml 中保留非敏感的配置项（如 host, port, database 等）
# 3. 敏感信息（密码、AccessKey）只通过环境变量传递
# 4. 本地开发时，可以创建 .env 文件并使用 python-dotenv 加载
# 5. 生产环境中，通过运维平台的环境变量配置功能设置